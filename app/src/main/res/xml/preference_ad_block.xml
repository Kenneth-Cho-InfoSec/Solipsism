<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/settings_advanced">
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_settings_shield"
            android:key="cb_block_ads"
            android:title="@string/block_ads"/>
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_settings_shield"
            android:key="cb_ublock_origin"
            android:summary="@string/ublock_origin_summary"
            android:title="@string/ublock_origin"/>
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_action_refresh"
            android:key="cb_filter_auto_update"
            android:summary="@string/filter_lists_auto_update_summary"
            android:title="@string/filter_lists_auto_update"/>
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_action_refresh"
            android:key="cb_filter_wifi_only"
            android:summary="@string/filter_lists_wifi_only_summary"
            android:title="@string/filter_lists_wifi_only"/>
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_settings_text"
            android:key="cb_cosmetic_filters"
            android:summary="@string/cosmetic_filters_summary"
            android:title="@string/cosmetic_filters"/>
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_settings_text"
            android:key="cb_block_gif"
            android:summary="@string/block_gif_summary"
            android:title="@string/block_gif"/>
        <Preference
            android:icon="@drawable/ic_settings_text"
            android:key="custom_filters"
            android:summary="@string/custom_filters_summary"
            android:title="@string/custom_filters"/>
        <Preference
            android:icon="@drawable/ic_action_plus"
            android:key="preference_filter_lists"
            android:summary="@string/filter_lists_summary"
            android:title="@string/filter_lists"/>
        <Preference
            android:icon="@drawable/ic_settings_globe"
            android:key="preference_hosts_source"
            android:summary="@string/block_source_default"
            android:title="@string/block_ad_source"/>
        <Preference
            android:icon="@drawable/ic_action_refresh"
            android:key="preference_hosts_refresh_force"
            android:summary="@string/block_ad_remote_refresh_frequency_description"
            android:title="@string/block_ad_refresh_now"/>
    </PreferenceCategory>
</PreferenceScreen>
