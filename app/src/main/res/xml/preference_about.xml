<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/settings_about">
        <Preference
            android:icon="@drawable/ic_settings_globe"
            android:summary="@string/url_twitter"
            android:title="@string/action_follow_me">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://ko-fi.com/kennethchoinfosec">
                <extra
                    android:name="SOURCE"
                    android:value="SELF" />
            </intent>
        </Preference>
        <Preference
            android:icon="@drawable/ic_settings_info"
            android:key="pref_version"
            android:title="@string/version" />
