    <PreferenceCategory android:title="@string/settings_cluster_experience">
        <Preference
            app:icon="@drawable/ic_action_desktop"
            app:fragment="com.krystelligence.solipsism.settings.fragment.GraphicsSettingsFragment"
            app:summary="@string/settings_graphics_summary"
            app:title="Graphics" />
