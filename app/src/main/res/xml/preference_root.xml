            app:summary="@string/settings_homepage_summary"
            app:title="Homepage" />
        <Preference
            app:icon="@drawable/ic_settings_download"
            app:fragment="com.krystelligence.solipsism.settings.fragment.DownloadSettingsFragment"
            app:summary="@string/settings_downloads_summary"
            app:title="Downloads" />
        <Preference
            app:icon="@drawable/ic_action_settings"
            app:fragment="com.krystelligence.solipsism.settings.fragment.NavigationSettingsFragment"
            app:summary="@string/settings_navigation_summary"
            app:title="Navigation" />
        <Preference
