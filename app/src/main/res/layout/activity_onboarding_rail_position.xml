<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboarding_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/onboarding_top_app_bar"
        style="@style/Widget.Material3.Toolbar.Surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:minHeight="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_action_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/onboarding_rail_title"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/onboarding_rail_summary"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

        <RadioGroup
            android:id="@+id/onboarding_rail_choices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:checkedButton="@id/onboarding_rail_right">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/onboarding_rail_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/browser_core_choice_background"
                android:button="@null"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:padding="16dp"
                android:text="@string/onboarding_rail_left"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/onboarding_rail_right"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/browser_core_choice_background"
                android:button="@null"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:padding="16dp"
                android:text="@string/onboarding_rail_right"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/onboarding_rail_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/browser_core_choice_background"
                android:button="@null"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:padding="16dp"
                android:text="@string/settings_rail_position_top"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/onboarding_rail_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/browser_core_choice_background"
                android:button="@null"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:padding="16dp"
                android:text="@string/settings_rail_position_bottom"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/onboarding_rail_experimental_note"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_rail_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minHeight="56dp"
            android:text="@string/onboarding_next"
            android:textColor="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorAccent" />
    </LinearLayout>
    </ScrollView>
</LinearLayout>
