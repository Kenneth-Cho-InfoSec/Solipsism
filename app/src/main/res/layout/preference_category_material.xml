<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/material_grid_margin"
    android:layout_marginTop="24dp"
    android:layout_marginEnd="@dimen/material_grid_margin"
    android:layout_marginBottom="8dp"
    android:background="@null"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Solipsism.PreferenceCategory" />

    <TextView
        android:id="@android:id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="4"
        android:textAppearance="@style/TextAppearance.Solipsism.PreferenceSummary"
        android:visibility="gone" />

</LinearLayout>
