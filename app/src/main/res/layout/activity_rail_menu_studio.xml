<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/studio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/studio_phone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:background="@drawable/solipsism_panel_background"
        android:clipChildren="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="9:21"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/studio_preview_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface" />

        <LinearLayout
            android:id="@+id/studio_rail"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@drawable/solipsism_rail_background"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="42dp"
            android:paddingEnd="10dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:id="@+id/studio_rail_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/studio_url_surface"
                android:layout_width="52dp"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="22dp"
                android:layout_weight="1"
                android:background="@drawable/solipsism_address_rail_background"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:id="@+id/studio_address_top_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/studio_url_label"
                    android:layout_width="170dp"
                    android:layout_height="0dp"
                    android:rotation="90"
                    android:background="@drawable/solipsism_url_button_background"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:text="@string/rail_menu_studio_url_placeholder"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toTopOf="@id/studio_address_bottom_actions"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/studio_address_top_actions" />

                <LinearLayout
                    android:id="@+id/studio_address_bottom_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/studio_rail_bottom_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical" />

            <ImageButton
                android:id="@+id/studio_overflow_button"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/solipsism_blend_button_background"
                android:contentDescription="@string/action_more"
                android:padding="8dp"
                android:src="@drawable/ic_action_more_vertical"
                app:tint="?attr/iconColor" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/studio_overflow_menu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="top|start"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="86dp"
            android:background="@drawable/browser_overflow_menu_background"
            android:orientation="vertical"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="54dp"
            android:paddingBottom="9dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp"
                android:text="@string/rail_menu_studio_overflow"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="4dp"
                android:paddingBottom="5dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rail_menu_studio_quick_actions_label"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/studio_quick_actions_enabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/rail_menu_studio_quick_actions"
                    app:thumbIconTint="@color/settings_switch_thumb_icon_tint"
                    app:thumbTint="@color/settings_switch_thumb_tint"
                    app:trackTint="@color/settings_switch_track_tint"
                    app:showText="false"
                    app:useMaterialThemeColors="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/studio_quick_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="8dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/studio_overflow_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/confirm_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:minHeight="40dp"
        android:text="@string/rail_menu_studio_confirm"
        android:textColor="?attr/colorOnPrimary"
        android:textAllCaps="false"
        app:backgroundTint="?attr/colorAccent"
        app:cornerRadius="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
