<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button android:id="@+id/thr_none" android:layout_width="wrap_content" android:layout_height="32dp" android:text="No throttle" android:textSize="11sp" />
        <Button android:id="@+id/thr_slow" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Slow 3G" android:textSize="11sp" android:layout_marginStart="4dp" />
        <Button android:id="@+id/thr_off" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Offline" android:textSize="11sp" android:layout_marginStart="4dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/net_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
