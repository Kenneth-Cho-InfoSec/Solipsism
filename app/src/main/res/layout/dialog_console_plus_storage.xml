<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button android:id="@+id/store_cookies" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:text="Cookies" android:textColor="?android:attr/textColorPrimary" android:textSize="11sp" />
        <Button android:id="@+id/store_local" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:text="localStorage" android:textColor="?android:attr/textColorPrimary" android:textSize="11sp" android:layout_marginStart="4dp" />
        <Button android:id="@+id/store_session" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:text="sessionStorage" android:textColor="?android:attr/textColorPrimary" android:textSize="11sp" android:layout_marginStart="4dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/kv_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
