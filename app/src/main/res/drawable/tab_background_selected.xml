<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:dither="true"
            android:shape="rectangle">
            <corners android:radius="@dimen/browser_row_corner_radius" />
            <solid android:color="?selectedBackground" />
        </shape>
    </item>

    <item android:bottom="0dp" android:top="0dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/browser_row_corner_radius"/>
            <stroke android:width="1dp" android:color="?attr/colorOutline"/>
            <solid android:color="@color/transparent"/>
        </shape>
    </item>

</layer-list>
