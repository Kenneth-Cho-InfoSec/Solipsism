---
import '@fontsource-variable/archivo';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  type?: 'website' | 'article';
}
const { title, description, path = '/', type = 'website' } = Astro.props;
const canonical = new URL(path.replace(/^\//, ''), Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const socialImage = new URL(`${base}/assets/solipsism-logo.png`, Astro.site);
const pageType =
  path === '/'
    ? 'SoftwareApplication'
    : path.startsWith('/docs') || path.startsWith('/guides')
      ? 'TechArticle'
      : 'WebPage';

const schema = {
  '@context': 'https://schema.org',
  '@type': pageType,
  name: path === '/' ? 'Solipsism Browser' : title,
  ...(path === '/' ? { applicationCategory: 'BrowserApplication' } : {}),
  ...(path === '/' ? { operatingSystem: 'Android' } : {}),
  ...(path !== '/' ? { headline: title } : {}),
  description,
  url: canonical,
  image: socialImage,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Solipsism Browser',
    url: Astro.site,
  },
  ...(path === '/'
    ? {
        license: 'https://www.mozilla.org/MPL/2.0/',
        sameAs: 'https://github.com/Kenneth-Cho-InfoSec/Solipsism',
        downloadUrl:
          'https://github.com/Kenneth-Cho-InfoSec/Solipsism/releases/latest',
      }
    : {}),
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content="#171715"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#e9e7df"
      media="(prefers-color-scheme: light)"
    />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      type="image/png"
      href={`${base}/assets/solipsism-logo-128.png`}
    />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Solipsism Browser" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Solipsism Browser logo" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Solipsism Browser logo" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const modes = ['system', 'light', 'dark', 'amoled'];
        const saved = localStorage.getItem('solipsism-theme') || 'system';
        const mode = modes.includes(saved) ? saved : 'system';
        const dark =
          mode === 'dark' ||
          mode === 'amoled' ||
          (mode === 'system' &&
            matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme =
          mode === 'amoled' ? 'amoled' : dark ? 'dark' : 'light';
        document.documentElement.dataset.themeMode = mode;
      })();
    </script>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <script>
      import '../scripts/releases';

      const modes = ['system', 'light', 'dark', 'amoled'] as const;
      type Mode = (typeof modes)[number];

      const labels: Record<Mode, string> = {
        system: 'Theme: system',
        light: 'Theme: light',
        dark: 'Theme: dark',
        amoled: 'Theme: AMOLED black',
      };

      const root = document.documentElement;
      const themeButton = document.querySelector<HTMLButtonElement>(
        '[data-theme-control]',
      );

      function applyTheme(mode: Mode) {
        const dark =
          mode === 'dark' ||
          mode === 'amoled' ||
          (mode === 'system' &&
            matchMedia('(prefers-color-scheme: dark)').matches);
        root.dataset.theme =
          mode === 'amoled' ? 'amoled' : dark ? 'dark' : 'light';
        root.dataset.themeMode = mode;
        localStorage.setItem('solipsism-theme', mode);
        if (themeButton) {
          themeButton.setAttribute('aria-label', labels[mode]);
          themeButton.title = labels[mode];
        }
      }

      const stored = (localStorage.getItem('solipsism-theme') ||
        'system') as Mode;
      applyTheme(modes.includes(stored) ? stored : 'system');

      themeButton?.addEventListener('click', () => {
        const current = (root.dataset.themeMode || 'system') as Mode;
        const next = modes[(modes.indexOf(current) + 1) % modes.length]!;
        applyTheme(next);
      });

      matchMedia('(prefers-color-scheme: dark)').addEventListener(
        'change',
        () => {
          if (root.dataset.themeMode === 'system') applyTheme('system');
        },
      );

      /* Mobile navigation ------------------------------------------------- */
      const toggle =
        document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const nav = document.querySelector<HTMLElement>('[data-mobile-nav]');

      function setNav(open: boolean) {
        toggle?.setAttribute('aria-expanded', String(open));
        toggle?.setAttribute(
          'aria-label',
          open ? 'Close navigation' : 'Open navigation',
        );
        if (open) nav?.setAttribute('data-open', '');
        else nav?.removeAttribute('data-open');
      }

      toggle?.addEventListener('click', () => {
        setNav(toggle.getAttribute('aria-expanded') !== 'true');
      });

      nav
        ?.querySelectorAll('a')
        .forEach((link) => link.addEventListener('click', () => setNav(false)));

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && nav?.hasAttribute('data-open')) {
          setNav(false);
          toggle?.focus();
        }
      });

      document.addEventListener('click', (event) => {
        if (!nav?.hasAttribute('data-open')) return;
        const target = event.target as Node;
        if (!nav.contains(target) && !toggle?.contains(target)) setNav(false);
      });

      /* Scroll reveals ---------------------------------------------------- */
      const reduceMotion = matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;

      if (!reduceMotion && 'IntersectionObserver' in window) {
        root.classList.add('motion-ready');
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
        );
        document
          .querySelectorAll<HTMLElement>('.reveal')
          .forEach((element) => observer.observe(element));
      }

      /* Code copy --------------------------------------------------------- */
      document.querySelectorAll<HTMLElement>('.code-block').forEach((block) => {
        const pre = block.querySelector('pre');
        if (!pre) return;
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'code-block__copy';
        button.textContent = 'Copy';
        button.setAttribute('aria-label', 'Copy code to clipboard');
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.innerText);
            button.textContent = 'Copied';
            setTimeout(() => (button.textContent = 'Copy'), 1600);
          } catch {
            button.textContent = 'Select';
          }
        });
        block.append(button);
      });
    </script>
  </body>
</html>
