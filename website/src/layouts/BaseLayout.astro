---
import '@fontsource-variable/manrope';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
}
const { title, description, path = '/' } = Astro.props;
const canonical = new URL(path.replace(/^\//, ''), Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const socialImage = new URL(`${base}/assets/solipsism-logo.png`, Astro.site);
const pageType =
  path === '/'
    ? 'SoftwareApplication'
    : path === '/docs/' || path === '/guides/getting-started/'
      ? 'TechArticle'
      : 'WebPage';
const breadcrumbItems =
  path === '/docs/'
    ? [
        { name: 'Home', item: Astro.site },
        { name: 'Documentation', item: canonical },
      ]
    : path === '/guides/getting-started/'
      ? [
          { name: 'Home', item: Astro.site },
          { name: 'Documentation', item: new URL('docs/', Astro.site) },
          { name: 'Getting started', item: canonical },
        ]
      : [];
const breadcrumbSchema = breadcrumbItems.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: item.item,
      })),
    }
  : undefined;
const schema = {
  '@context': 'https://schema.org',
  '@type': pageType,
  name: path === '/' ? 'Solipsism Browser' : title,
  ...(path === '/' ? { applicationCategory: 'BrowserApplication' } : {}),
  ...(path === '/' ? { operatingSystem: 'Android' } : {}),
  ...(path !== '/' ? { headline: title } : {}),
  description,
  url: canonical,
  image: socialImage,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Solipsism Browser',
    url: Astro.site,
  },
  ...(path === '/'
    ? {
        license: 'https://www.mozilla.org/MPL/2.0/',
        sameAs: 'https://github.com/Kenneth-Cho-InfoSec/Solipsism',
      }
    : {}),
  downloadUrl:
    path === '/'
      ? 'https://github.com/Kenneth-Cho-InfoSec/Solipsism/releases/latest'
      : undefined,
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content="#f7f6fb"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#070709"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      type="image/png"
      href={`${base}/assets/solipsism-logo-128.png`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Solipsism Browser" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Solipsism Browser logo" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Solipsism Browser logo" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('solipsism-theme') || 'system';
        const dark =
          saved === 'dark' ||
          (saved === 'system' &&
            matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.dataset.themeMode = saved;
      })();
    </script>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
    {breadcrumbSchema && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbSchema)}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>(
        '[data-theme-control]',
      );
      const labels = {
        system: 'Theme: system',
        light: 'Theme: light',
        dark: 'Theme: dark',
      } as const;
      function applyTheme(mode: keyof typeof labels) {
        const dark =
          mode === 'dark' ||
          (mode === 'system' &&
            matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.dataset.themeMode = mode;
        localStorage.setItem('solipsism-theme', mode);
        if (themeButton) {
          themeButton.textContent =
            mode === 'system' ? '◐' : mode === 'dark' ? '●' : '○';
          themeButton.setAttribute('aria-label', labels[mode]);
          themeButton.title = labels[mode];
        }
      }
      const initial = (localStorage.getItem('solipsism-theme') ||
        'system') as keyof typeof labels;
      applyTheme(initial in labels ? initial : 'system');
      themeButton?.addEventListener('click', () => {
        const mode = document.documentElement.dataset
          .themeMode as keyof typeof labels;
        applyTheme(
          mode === 'system' ? 'light' : mode === 'light' ? 'dark' : 'system',
        );
      });
      matchMedia('(prefers-color-scheme: dark)').addEventListener(
        'change',
        () => {
          if (document.documentElement.dataset.themeMode === 'system')
            applyTheme('system');
        },
      );
      const toggle =
        document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const nav = document.querySelector<HTMLElement>('[data-mobile-nav]');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav?.toggleAttribute('data-open', !open);
      });
      nav?.querySelectorAll('a').forEach((link) =>
        link.addEventListener('click', () => {
          toggle?.setAttribute('aria-expanded', 'false');
          nav.removeAttribute('data-open');
        }),
      );
    </script>
  </body>
</html>
