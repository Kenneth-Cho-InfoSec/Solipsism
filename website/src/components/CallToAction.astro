---
import { SITE, withBase } from '../data/site';
const base = import.meta.env.BASE_URL;
---

<section class="cta" aria-labelledby="cta-heading">
  <div class="shell cta__inner">
    <div>
      <h2 id="cta-heading">Start with the stable core.</h2>
      <p>
        Install the official 9.4.0 APK, open a page, and move the rail where
        your thumb expects it. Antares can wait.
      </p>
    </div>
    <div class="cta__actions">
      <a
        class="button latest-download"
        data-latest-download
        href={SITE.latestRelease}>Download latest APK</a
      >
      <a class="text-link" href={withBase(base, '/guides/getting-started/')}
        >Read the getting-started guide</a
      >
    </div>
  </div>
</section>
