---
import { FOOTER_LINKS, SITE, withBase } from '../data/site';
const base = import.meta.env.BASE_URL;
const href = (target: string) => withBase(base, target);
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-line">
      <p>Private by intention. Adaptable by design.</p>
      <nav class="footer-links" aria-label="Footer">
        {FOOTER_LINKS.map((item) => <a href={href(item.path)}>{item.label}</a>)}
        <a href={SITE.issues} target="_blank" rel="noopener noreferrer"
          >Issues</a
        >
      </nav>
    </div>
    <div class="footer-base">
      <span>Solipsism Browser · {SITE.licenceName} · Built in the open</span>
      <span
        >No analytics, no tracking scripts. <a href={href('/docs/')}
          >Documentation</a
        ></span
      >
    </div>
  </div>
</footer>
