---
import { withBase } from '../data/site';
const base = import.meta.env.BASE_URL;
const href = (path: string) => withBase(base, path);

const screens = [
  {
    src: '/assets/screens/menu.webp',
    title: 'Overflow menu',
    caption:
      'New tab, incognito, history, downloads, bookmarks and settings in one surface.',
    alt: 'The Solipsism overflow menu open over the homepage, showing quick action icons and a list of commands including new tab, new incognito tab, history, downloads, bookmarks, find in page and settings.',
  },
  {
    src: '/assets/screens/tabs.webp',
    title: 'Tab overview',
    caption:
      'Tabs open as a full surface you can read, with the rail still holding the page controls.',
    alt: 'The Solipsism tab overview, a dark full-screen panel listing a single Homepage tab with a close button, beside the navigation rail.',
  },
  {
    src: '/assets/screens/themes.webp',
    title: 'App theme',
    caption:
      'Light, dark and true AMOLED black are one visible choice, not a hidden setting.',
    alt: 'The App theme dialog in Solipsism graphics settings, offering Light theme, Dark theme and Black theme (AMOLED) with a radio button each.',
  },
  {
    src: '/assets/screens/settings.webp',
    title: 'Settings',
    caption:
      'Privacy, site permissions, bookmarks and graphics are grouped in one readable list.',
    alt: 'The Solipsism settings screen, listing General, Advanced, Privacy, Site permissions, Bookmark, Graphics and Audio under Basics and Experience.',
  },
];
---

<section class="section section--tight" aria-labelledby="screens-heading">
  <div class="shell section-head reveal">
    <h2 id="screens-heading">The rail, in the app.</h2>
    <p>
      Four screens from 9.4.0, uncropped. They show the surfaces the features
      above are built into.
    </p>
  </div>
  <div class="shell showcase showcase--three">
    {
      screens.map((screen) => (
        <figure class="showcase__item reveal">
          <img
            src={href(screen.src)}
            width="720"
            height="1600"
            alt={screen.alt}
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <strong>{screen.title}</strong>
            {screen.caption}
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
