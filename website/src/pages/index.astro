---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RailPlayground from '../components/RailPlayground.astro';
import FeatureBands from '../components/FeatureBands.astro';
import FilterLab from '../components/FilterLab.astro';
import Showcase from '../components/Showcase.astro';
import CoreStory from '../components/CoreStory.astro';
import ProofTiles from '../components/ProofTiles.astro';
import FaqList from '../components/FaqList.astro';
import CallToAction from '../components/CallToAction.astro';
import { FAQS } from '../data/faqs';
import { SITE, withBase } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Solipsism Browser · Android browsing within reach"
  description="A privacy-focused Android browser built on WebView, with a rail-first interface that keeps tabs, search and controls within one-handed reach. Antares is an optional experimental core."
  path="/"
>
  <Header path="/" />
  <main id="main">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="shell hero__grid">
        <div class="hero__copy">
          <h1 id="hero-heading">Android browsing within reach.</h1>
          <p class="hero__lead">
            A privacy-focused Android browser built on WebView. Tabs, search and
            controls sit in a rail at the screen edge, so one hand can do the
            work of two.
          </p>
          <div class="hero__actions">
            <a
              class="button latest-download"
              data-latest-download
              href={SITE.latestRelease}>Download latest APK</a
            >
            <a class="text-link" href={withBase(base, '/docs/')}
              >Read the documentation</a
            >
          </div>
          <p class="hero__meta">
            <span
              >Version <span data-latest-version>checking GitHub…</span></span
            >
            <span data-latest-meta>APK size pending</span>
            <span>Android 8.0+</span>
          </p>
          <div class="hero__links" aria-label="Project links">
            <a href={withBase(base, '/features/')}>Explore features</a>
            <a href={withBase(base, '/guides/getting-started/')}
              >Set up Solipsism</a
            >
            <a href={withBase(base, '/compare/')}>Compare browsers</a>
            <a
              href="https://github.com/Kenneth-Cho-InfoSec/Solipsism"
              target="_blank"
              rel="noopener noreferrer">Source ↗</a
            >
          </div>
        </div>

        <div class="hero__stage">
          <RailPlayground />
        </div>
      </div>
    </section>

    <section class="section section--flip" aria-labelledby="bands-heading">
      <div class="shell section-head reveal">
        <h2 id="bands-heading">Five controls you will actually use.</h2>
        <p>
          Every claim below maps to a setting in the Android app. The switches
          are a preview of the real state, not a mock-up of grey bars.
        </p>
      </div>
      <FeatureBands />
    </section>

    <Showcase />

    <FilterLab />

    <CoreStory />

    <ProofTiles />

    <section class="section" aria-labelledby="faq-heading">
      <div class="shell">
        <div class="section-head reveal">
          <h2 id="faq-heading">Before you install.</h2>
          <p>
            The questions that decide whether this browser suits your device and
            your expectations.
          </p>
        </div>
        <div class="reveal">
          <FaqList items={FAQS} />
        </div>
      </div>
    </section>

    <CallToAction />
  </main>
  <Footer />
</BaseLayout>
