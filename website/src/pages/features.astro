---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScreenStrip from '../components/ScreenStrip.astro';
import RailPlayground from '../components/RailPlayground.astro';
import { FEATURE_GROUPS } from '../data/features';
import { SITE, withBase } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Solipsism Browser features · rail, privacy and blocking"
  description="Every feature in Solipsism Browser, grouped by job: rail navigation, privacy controls, content blocking, userscripts, download scanning, appearance and the optional Antares core."
  path="/features/"
>
  <Header path="/features/" />
  <main id="main">
    <section
      class="page-head shell page-head--split"
      aria-labelledby="features-heading"
    >
      <div class="page-head__copy">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={withBase(base, '/')}>Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Features</span>
        </nav>
        <h1 id="features-heading" style="margin-top: 28px">
          One rail. The rest is the page.
        </h1>
        <p>
          Solipsism keeps frequent controls at the screen edge and leaves the
          webpage as the main surface. Everything below is present in the 9.4.0
          release; limits and experimental states are named next to the claim.
        </p>
        <div class="page-head__actions">
          <a
            class="button latest-download"
            data-latest-download
            href={SITE.latestRelease}>Download latest APK</a
          >
          <a class="text-link" href={withBase(base, '/docs/')}
            >Read the technical documentation</a
          >
        </div>
      </div>
      <RailPlayground class="page-head__play" />
    </section>

    <section class="section section--tight" aria-labelledby="groups-heading">
      <div class="shell">
        <h2 id="groups-heading" class="sr-only">Feature groups</h2>
        {
          FEATURE_GROUPS.map((group) => (
            <div class="feature-group" id={group.id}>
              <div class="feature-group__intro reveal">
                <h2>{group.title}</h2>
                <p>{group.summary}</p>
              </div>
              <div class="feature-list">
                {group.items.map((item) => (
                  <div class="feature-item reveal">
                    <h3>{item.name}</h3>
                    <p>
                      {item.detail}
                      {item.limit && (
                        <span class="feature-item__limit">{item.limit}</span>
                      )}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <ScreenStrip />

    <section class="section section--flip" aria-labelledby="core-heading">
      <div class="shell split">
        <div class="reveal">
          <h2 id="core-heading">WebView is the core. Antares is optional.</h2>
        </div>
        <div class="prose reveal">
          <p>
            Android System WebView renders every page by default. Rendering,
            Safe Browsing and some web capabilities therefore follow your
            installed provider and Android version.
          </p>
          <p>
            Solipsism 9.4.0 also supports Antares 0.5.0, an experimental
            Servo-based core distributed as a separate signed package. It
            requires Android 13 or newer and a supported 64-bit device, and it
            is never selected automatically.
          </p>
          <p>
            <strong>Use WebView unless you are deliberately testing.</strong>
            CAPTCHA, media and complex interaction can fail on Antares, and page history,
            form state, media state and cookies are not promised across a core switch.
          </p>
          <div class="link-row">
            <a class="text-link" href={withBase(base, '/docs/antares/')}
              >Read the Antares notes</a
            >
            <a
              class="text-link"
              href={SITE.antaresNotes}
              target="_blank"
              rel="noopener noreferrer">Engine documentation ↗</a
            >
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
