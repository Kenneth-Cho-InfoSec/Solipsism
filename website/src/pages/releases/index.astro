---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ReleaseMount from '../../components/ReleaseMount.astro';
import { SITE, withBase } from '../../data/site';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Solipsism Browser releases · APK downloads and notes"
  description="Browse release notes and download APK files for Solipsism Browser on supported Android devices, using assets published by the project on GitHub Releases."
  path="/releases/"
>
  <Header path="/releases/" />
  <main id="main">
    <section class="page-head shell" aria-labelledby="releases-heading">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={withBase(base, '/')}>Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Releases</span>
      </nav>
      <h1 id="releases-heading" style="margin-top: 28px">
        Every release, with its own notes.
      </h1>
      <p>
        This archive follows GitHub Releases at runtime. APK buttons use the
        exact assets attached by the maintainer, and asset hosts are checked
        before a link is shown.
      </p>
      <div class="page-head__actions">
        <a class="button" href={SITE.latestRelease}>Download the latest APK</a>
        <a class="text-link" href={SITE.releases}>All releases on GitHub</a>
      </div>
    </section>

    <section class="section section--tight" aria-labelledby="archive-heading">
      <div class="shell">
        <h2 id="archive-heading" class="sr-only">All releases</h2>
        <ReleaseMount mode="archive" />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
