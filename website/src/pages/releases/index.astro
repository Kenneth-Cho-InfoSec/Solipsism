---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ReleaseMount from '../../components/ReleaseMount.astro';
---

<BaseLayout
  title="Solipsism Browser releases — APK downloads and notes"
  description="Browse release notes and download APK files for Solipsism Browser on supported Android devices, using assets published by the project on GitHub Releases."
  path="/releases/"
>
  <Header />
  <main id="main">
    <section class="archive-hero shell">
      <h1>Releases and APK downloads.</h1><p>
        This live archive follows GitHub Releases automatically. APK buttons use
        the exact assets attached by the project maintainer.
      </p>
    </section><section
      class="shell archive-section"
      aria-labelledby="archive-heading"
    >
      <h2 id="archive-heading" class="sr-only">All releases</h2><ReleaseMount
        mode="archive"
      />
    </section>
  </main>
  <Footer />
</BaseLayout>
