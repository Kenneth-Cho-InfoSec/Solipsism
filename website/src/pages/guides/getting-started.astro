---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { SITE, withBase } from '../../data/site';

const base = import.meta.env.BASE_URL;
const href = (path: string) => withBase(base, path);

const sections = [
  { id: 'install', heading: 'Install' },
  { id: 'first-page', heading: 'Open a page' },
  { id: 'rail', heading: 'Shape the rail' },
  { id: 'privacy', heading: 'Set privacy' },
  { id: 'homepage', heading: 'Make a homepage' },
  { id: 'antares', heading: 'Try Antares' },
];
---

<DocsLayout
  title="Getting started with Solipsism Browser"
  description="Install Solipsism on Android, open your first page, shape the rail, set the privacy controls you use, and decide whether to try the experimental Antares core."
  path="/guides/getting-started/"
  sections={sections}
  next={{ label: 'Privacy controls', path: '/docs/privacy/' }}
>
  <h1>Set up Solipsism in five minutes.</h1>
  <p>
    This is the short path: install the official build, open a page, move the
    rail where your hand expects it, and choose the privacy settings you
    actually use. Screenshots and labels match the 9.4.0 interface; wording can
    change between releases.
  </p>

  <div class="page-head__actions">
    <a
      class="button latest-download"
      data-latest-download
      href={SITE.latestRelease}>Download latest APK</a
    >
    <a class="text-link" href={href('/docs/installation/')}
      >Read the installation notes</a
    >
  </div>

  <section id="install">
    <h2>Install</h2>
    <ol class="steps">
      <li>
        <div>
          <h3>Get the official APK</h3>
          <p>
            Open the <a
              href={SITE.releases}
              target="_blank"
              rel="noopener noreferrer">releases page</a
            > and download the APK attached to the current release. In 9.4.0 that
            is a single file, <code>Solipsism-Browser-v9.4.0.apk</code>.
          </p>
        </div>
      </li>
      <li>
        <div>
          <h3>Approve the source, not the world</h3>
          <p>
            Android asks you to allow installs from the app you use to open the
            file. Keep that permission limited to that app, and revoke it when
            you are done.
          </p>
        </div>
      </li>
      <li>
        <div>
          <h3>Launch it</h3>
          <p>
            Solipsism opens on its homepage with Android WebView selected. You
            do not need Antares, an account, or any extra download to browse.
          </p>
        </div>
      </li>
    </ol>
  </section>

  <section id="first-page">
    <h2>Open a page</h2>
    <ol class="steps">
      <li>
        <div>
          <h3>Tap the URL field in the rail</h3>
          <p>
            The field expands into an editor. Type an address or a search phrase
            and use the keyboard’s Go action.
          </p>
        </div>
      </li>
      <li>
        <div>
          <h3>Open the tab overview</h3>
          <p>
            Tabs live in the rail. The overview is a full surface, not a strip
            of favicons, so you can tell pages apart.
          </p>
        </div>
      </li>
      <li>
        <div>
          <h3>Try a long press on refresh</h3>
          <p>
            Long-pressing refresh reloads with JavaScript disabled, useful for a
            page that will not settle.
          </p>
        </div>
      </li>
    </ol>
  </section>

  <section id="rail">
    <h2>Shape the rail</h2>
    <p>
      Open Settings and choose <strong>Rail &amp; Menu Studio</strong>. Move
      supported actions between the rail and the overflow menu, drag rail icons
      into the order you want, choose the rail side and size, and restore the
      default layout whenever you want.
    </p>
    <ul>
      <li>Up to eight movable rail actions.</li>
      <li>Five optional quick actions in the overflow menu.</li>
      <li>Tabs and the menu action stay permanent.</li>
      <li>
        The same action cannot be duplicated across the rail and the menu.
      </li>
      <li>Small, Medium, Large and Super Compact sizes.</li>
    </ul>
  </section>

  <section id="privacy">
    <h2>Set privacy</h2>
    <p>
      Open <strong>Privacy</strong> and decide four things before you browse anything
      sensitive:
    </p>
    <ul>
      <li>
        Whether third-party cookies are allowed, and whether cookies, history,
        cache or web storage should clear on exit.
      </li>
      <li>Whether to send Do Not Track and strip identifying headers.</li>
      <li>
        Whether WebRTC should be available. It is off by default in the privacy
        settings.
      </li>
      <li>
        Which site permissions you grant, knowing that the entries marked
        Experimental are best-effort where WebView does not enforce them.
      </li>
    </ul>
    <div class="callout callout--warn">
      <strong>Read the limits once</strong>
      <p>
        Solipsism does not hide your IP address, prevent fingerprinting, or make
        an untrusted download safe. It gives you control over what WebView
        exposes, and it says so.
      </p>
    </div>
  </section>

  <section id="homepage">
    <h2>Make a homepage</h2>
    <p>
      The homepage can show bookmarks, a wallpaper, a motto, a clock and a
      configurable date. You can import static HTML and CSS or edit it in the
      app.
    </p>
    <p>
      Custom homepage content is sanitised and stored in app-private storage.
      Scripts, forms, frames, downloads, remote resources and file access are
      disabled for static custom homepages.
    </p>
  </section>

  <section id="antares">
    <h2>Try Antares, carefully</h2>
    <p>
      Antares is an experimental Servo core in a separate package. It requires
      Android 13 or newer and a supported 64-bit device, and Solipsism verifies
      the package name, signing digest and protocol before enabling it.
    </p>
    <p>
      If you do try it, expect some sites to fail. CAPTCHA, media and complex
      interaction are the usual problems. Select Android WebView again and
      reload when that happens.
    </p>
    <div class="link-row">
      <a class="text-link" href={href('/docs/antares/')}>Antares notes</a>
      <a
        class="text-link"
        href={SITE.antaresNotes}
        target="_blank"
        rel="noopener noreferrer">Engine documentation ↗</a
      >
    </div>
  </section>
</DocsLayout>
